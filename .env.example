# PostHog analytics. Copy this file to .env.local.
# Project token: PostHog -> Settings -> Project -> Project token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog instance URL. Leave unset for PostHog US Cloud. For self-hosted,
# set the instance URL (dev example: http://localhost:8000); in production it
# must be a publicly reachable HTTPS URL (e.g. a Cloudflare Tunnel hostname)
# because both visitor browsers and Vercel's rewrite proxy must reach it.
# See docs/POSTHOG-SELF-HOST.md.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=local

# Local events log to the browser console when true. They are only sent to
# PostHog from localhost when CAPTURE_LOCALHOST is also true.
NEXT_PUBLIC_POSTHOG_DEBUG=true
NEXT_PUBLIC_POSTHOG_CAPTURE_LOCALHOST=false

# GoHighLevel inbound webhook URL. When set, every lead submission is
# mirrored into GHL (fire-and-forget, alongside the Web3Forms email).
# Leave unset until the GHL location + workflow exist.
NEXT_PUBLIC_GHL_WEBHOOK_URL=

# Search-console ownership tokens. Read at build time in src/app/layout.tsx and
# rendered as verification <meta> tags; unset means the tag is simply omitted.
# Google:  Search Console -> Add property -> HTML tag -> copy the content="..."
#          value only (not the whole tag).
# Bing:    Bing Webmaster Tools -> Site verification -> Meta tag -> msvalidate.01
# These are public values (they ship in the HTML) — not secrets.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
